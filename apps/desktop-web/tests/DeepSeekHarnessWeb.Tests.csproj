      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../DeepSeekHarnessWeb.csproj" />
    <None Include="../app.ico" Link="app.ico" CopyToOutputDirectory="PreserveNewest" />
