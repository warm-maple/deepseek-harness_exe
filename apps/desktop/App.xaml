<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="DeepSeekHarness.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DeepSeekHarness.Desktop"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- DeepSeek Harness Web 浅色主题（design-platform light tokens） -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <local:InverseBoolConverter x:Key="InverseBool" />
    <local:NullToVisibilityConverter x:Key="NullToVisibility" />
    <local:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
    <local:ToolKindGlyphConverter x:Key="ToolKindGlyph" />
    <local:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
    <local:CountToVisibilityConverter x:Key="CountToVisibility" />
    <local:TodoGlyphBrushConverter x:Key="TodoGlyphBrush" />
    <local:BoolToStrikethroughConverter x:Key="BoolToStrikethrough" />
    <local:StringEmptyToVisibilityConverter x:Key="StringEmptyToVisibility" />

    <!-- 浅色色板 -->
    <SolidColorBrush x:Key="WindowBrush" Color="#FFFFFF" />          <!-- bg-base -->
    <SolidColorBrush x:Key="SidebarBrush" Color="#F9FAFB" />         <!-- sidebar-fill -->
    <SolidColorBrush x:Key="PanelBrush" Color="#F9FAFB" />           <!-- module-platform -->
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="#FFFFFF" />     <!-- elevated fill -->
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#F1F3F5" />           <!-- interactive hover -->
    <SolidColorBrush x:Key="ActiveBrush" Color="#E9EBF2" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#EBEEF2" />        <!-- sidebar active -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#0F1115" />         <!-- brand primary (黑) -->
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#43454A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4176E6" />          <!-- deepseek-500 -->
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#679EFE" />     <!-- deepseek-400 -->
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EDF3FE" />      <!-- deepseek-50 -->
    <SolidColorBrush x:Key="TextBrush" Color="#0F1115" />            <!-- label-primary -->
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#61666B" />   <!-- label-secondary -->
    <SolidColorBrush x:Key="MutedTextBrush" Color="#81868C" />       <!-- label-tertiary -->
    <SolidColorBrush x:Key="FaintTextBrush" Color="#ADB2B8" />       <!-- label-caption -->
    <SolidColorBrush x:Key="BorderBrush" Color="#E6E6E6" />          <!-- border-l2 -->
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#D6D6D6" />    <!-- border-l4 -->
    <SolidColorBrush x:Key="UserBubbleBrush" Color="#EDF3FE" />      <!-- bubble -->
    <SolidColorBrush x:Key="UserBubbleBorderBrush" Color="#E4EDFD" />
    <SolidColorBrush x:Key="CodeBlockBrush" Color="#F9FAFB" />       <!-- code block -->
    <SolidColorBrush x:Key="InlineCodeBrush" Color="#EBEEF2" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="WarnBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#EC1313" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDECEC" />
    <SolidColorBrush x:Key="AmberPanelBrush" Color="#FEF5E7" />      <!-- amber-100 -->
    <SolidColorBrush x:Key="AmberBorderBrush" Color="#F0C87B" />

    <Style TargetType="Window">
      <Setter Property="Background" Value="{StaticResource WindowBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
      <Setter Property="UseLayoutRounding" Value="True" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- 主按钮（DeepSeek 蓝底白字，web 主操作按钮样式） -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.85" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 次要按钮（白底细边框） -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="{StaticResource WindowBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.8" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}" />

    <!-- 危险按钮（停止） -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
      <Setter Property="Foreground" Value="#B42318" />
      <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
      <Setter Property="BorderBrush" Value="#F3C1BC" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 输入框 -->
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="{StaticResource WindowBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
      <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="SelectionTextBrush" Value="#FFFFFF" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
    </Style>

    <!-- 滚动条（浅色） -->
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="10" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="#C8CACF" CornerRadius="5" Margin="2,0" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 侧栏列表项（web sidebar nav item） -->
    <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,8">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SelectedBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 可折叠卡片 Expander（浅色） -->
    <Style x:Key="CardExpanderStyle" TargetType="Expander">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="0">
              <StackPanel>
                <ToggleButton x:Name="HeaderSite" Focusable="False" Cursor="Hand"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <ContentPresenter />
                    </ControlTemplate>
                  </ToggleButton.Template>
                  <ContentPresenter ContentSource="Header" />
                </ToggleButton>
                <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" ContentSource="Content" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger SourceName="HeaderSite" Property="IsChecked" Value="True">
                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
