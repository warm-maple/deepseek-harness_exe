<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DeepSeekHarness.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeepSeekHarness.Desktop"
        Title="DeepSeek Harness" Width="1280" Height="840" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <!-- 消息模板：用户消息右侧浅蓝气泡；助手消息含思考、工具卡片、待办与 Markdown -->
    <DataTemplate x:Key="MessageTemplate">
      <Grid Margin="0,0,0,20">
        <StackPanel x:Name="AssistantPanel">
          <!-- 思考过程（可折叠） -->
          <Expander x:Name="ThinkingExpander" Style="{StaticResource CardExpanderStyle}" Margin="0,0,0,6"
                    Visibility="{Binding Thinking, Converter={StaticResource NotEmptyToVisibility}}">
            <Expander.Header>
              <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="10,6">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="🧠" FontSize="12" />
                  <TextBlock Text="思考过程" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="8,0,0,0" />
                  <TextBlock Text="▾" FontSize="11" Foreground="{StaticResource FaintTextBrush}" Margin="8,1,0,0" />
                </StackPanel>
              </Border>
            </Expander.Header>
            <TextBlock Text="{Binding Thinking}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                       FontFamily="Consolas, Cascadia Mono, Microsoft YaHei" FontSize="12.5" Margin="4,8,4,2" />
          </Expander>

          <!-- 工具调用卡片 -->
          <ItemsControl ItemsSource="{Binding ToolCalls}" Margin="0,0,0,6"
                        Visibility="{Binding ToolCalls.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=any}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                        Background="{StaticResource CardBrush}" Padding="12,9" Margin="0,0,0,6">
                  <StackPanel>
                    <Grid>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Kind, Converter={StaticResource ToolKindGlyph}}" FontSize="12" />
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Margin="7,0,0,0" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Margin="0,0,5,0">
                          <Ellipse.Style>
                            <Style TargetType="Ellipse">
                              <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="completed">
                                  <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="failed">
                                  <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusLabel}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding PrettyInput}" TextWrapping="Wrap" Margin="0,8,0,0"
                               FontFamily="Consolas, Cascadia Mono, Microsoft YaHei" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Visibility="{Binding RawInput, Converter={StaticResource NotEmptyToVisibility}}" />
                    <Border Background="{StaticResource CodeBlockBrush}" CornerRadius="6" Padding="10,7" Margin="0,8,0,0"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Visibility="{Binding RawOutput, Converter={StaticResource NotEmptyToVisibility}}">
                      <TextBlock Text="{Binding RawOutput}" TextWrapping="Wrap" FontSize="12"
                                 FontFamily="Consolas, Cascadia Mono, Microsoft YaHei" Foreground="{StaticResource TextBrush}" />
                    </Border>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- 待办清单卡片 -->
          <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                  Background="{StaticResource CardBrush}" Padding="12,10" Margin="0,0,0,8"
                  Visibility="{Binding Todos.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=any}">
            <StackPanel>
              <TextBlock Text="待办" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
              <ItemsControl ItemsSource="{Binding Todos}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                      <TextBlock Text="{Binding Glyph}" FontSize="13" Foreground="{Binding Status, Converter={StaticResource TodoGlyphBrush}}" Width="18" />
                      <TextBlock Text="{Binding Content}" FontSize="13" TextWrapping="Wrap"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 TextDecorations="{Binding IsChecked, Converter={StaticResource BoolToStrikethrough}}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- 正文（Markdown） -->
          <local:MarkdownView Markdown="{Binding Text}" IsHitTestVisible="False" />
          <TextBlock Text="▍" FontSize="15" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0"
                     Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- 用户消息气泡（web bubble：浅蓝、圆角 22） -->
        <Border x:Name="UserBubble" HorizontalAlignment="Right" MaxWidth="525" Visibility="Collapsed"
                Background="{StaticResource UserBubbleBrush}" BorderBrush="{StaticResource UserBubbleBorderBrush}"
                BorderThickness="1" CornerRadius="22" Padding="13,10">
          <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="14.5" />
        </Border>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Role}" Value="user">
          <Setter TargetName="AssistantPanel" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="UserBubble" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="282" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ============ 左侧栏（web sidebar-fill #F9FAFB） ============ -->
    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="12,10,12,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="8,4,8,14">
          <TextBlock Text="DeepSeek" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
          <TextBlock Text="Harness" FontSize="22" FontWeight="SemiBold" Margin="0,1,0,0" />
        </StackPanel>

        <Button Grid.Row="1" Content="＋  新对话" Style="{StaticResource PrimaryButtonStyle}"
                HorizontalContentAlignment="Left" Click="NewConversation_Click" Margin="0,0,0,16" />

        <TextBlock Grid.Row="2" Text="工作区" Foreground="{StaticResource FaintTextBrush}" FontSize="11" Margin="8,0,0,6" />
        <Button Grid.Row="3" HorizontalContentAlignment="Left" Click="ChooseWorkspace_Click" Margin="0,0,0,14"
                Style="{StaticResource SecondaryButtonStyle}" Background="Transparent" BorderBrush="Transparent" Padding="8,6">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="📁" FontSize="13" />
            <TextBlock Text="{Binding WorkspaceLabel}" TextTrimming="CharacterEllipsis" MaxWidth="180"
                       FontSize="13" Margin="8,0,0,0" />
          </StackPanel>
        </Button>

        <TextBlock Grid.Row="4" Text="会话" Foreground="{StaticResource FaintTextBrush}" FontSize="11" Margin="8,0,0,6" />

        <ListBox Grid.Row="4" ItemsSource="{Binding Conversations}" SelectedItem="{Binding SelectedConversation}"
                 ItemContainerStyle="{StaticResource SidebarItemStyle}" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,18,0,8">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Workspace}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource FaintTextBrush}"
                           FontSize="11" Margin="0,2,0,0" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="5">
          <Button Content="⚙  设置" Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Left"
                  Background="Transparent" BorderBrush="Transparent" Click="Settings_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ 主区域 ============ -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- 顶部标题栏（仅在有会话时显示） -->
      <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,10"
              Background="{StaticResource WindowBrush}"
              Visibility="{Binding HasMessages, Converter={StaticResource BoolToVisibility}}">
        <Grid>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectedConversation.Title}" FontSize="15" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" MaxWidth="560" />
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,2,0,0" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,8,0"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
              <TextBlock Text="{Binding Settings.Model}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            </Border>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="8,4"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
              <TextBlock Text="{Binding PermissionLabel}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 权限请求横幅 -->
      <Border Grid.Row="1" Margin="24,12,24,0" Padding="14,11" CornerRadius="10"
              Background="{StaticResource AmberPanelBrush}" BorderBrush="{StaticResource AmberBorderBrush}"
              BorderThickness="1" Visibility="{Binding HasPendingPermission, Converter={StaticResource BoolToVisibility}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Agent 请求执行工具" FontWeight="SemiBold" FontSize="13" Foreground="#78350F" />
            <TextBlock Text="{Binding PendingPermission.ToolLabel}" Foreground="#92400E" FontSize="12" Margin="0,3,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="拒绝" Style="{StaticResource SecondaryButtonStyle}" Click="RejectPermission_Click" Margin="0,0,8,0" />
            <Button Content="允许一次" Style="{StaticResource PrimaryButtonStyle}" Click="AllowPermission_Click" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- 内容区 -->
      <Grid Grid.Row="2">
        <!-- 空状态 Hero（web hero：标题 + 工作区 chip + 输入卡 + 底部操作行） -->
        <Grid Visibility="{Binding HasMessages, Converter={StaticResource InverseBoolToVisibility}}">
          <StackPanel MaxWidth="820" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,84,40,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <TextBlock Text="🪸" FontSize="30" Margin="0,0,10,0" />
              <TextBlock Text="DeepSeek Harness" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Button HorizontalAlignment="Center" Margin="0,14,0,0" Click="ChooseWorkspace_Click"
                    Style="{StaticResource SecondaryButtonStyle}" Background="Transparent" BorderBrush="Transparent" Padding="8,4">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="📁" FontSize="12" />
                <TextBlock Text="{Binding WorkspaceLabel}" FontSize="13" Margin="6,0,0,0" />
                <TextBlock Text="▾" FontSize="10" Foreground="{StaticResource FaintTextBrush}" Margin="6,1,0,0" />
              </StackPanel>
            </Button>
            <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="16"
                    Background="{StaticResource WindowBrush}" Margin="0,16,0,0">
              <Grid>
                <TextBox x:Name="HeroBox" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="150" MaxHeight="280" FontSize="16" Padding="20,18" BorderThickness="0"
                         Background="Transparent" AcceptsReturn="True" TextWrapping="Wrap"
                         PreviewKeyDown="HeroBox_PreviewKeyDown" VerticalScrollBarVisibility="Auto" />
                <TextBlock Text="描述你想构建或修改的内容…" IsHitTestVisible="False" Margin="20,20,0,0"
                           Foreground="{StaticResource FaintTextBrush}" FontSize="16"
                           Visibility="{Binding InputText, Converter={StaticResource StringEmptyToVisibility}}" />
              </Grid>
            </Border>
            <Grid Margin="4,12,4,0">
              <TextBlock Text="按 Enter 发送" Foreground="{StaticResource FaintTextBrush}" FontSize="12" VerticalAlignment="Center" />
              <Button Content="发送" Style="{StaticResource PrimaryButtonStyle}" Click="Send_Click"
                      IsEnabled="{Binding CanSend}" MinWidth="88" HorizontalAlignment="Right" />
            </Grid>
          </StackPanel>
        </Grid>

        <!-- 会话消息区 -->
        <Grid Visibility="{Binding HasMessages, Converter={StaticResource BoolToVisibility}}">
          <ScrollViewer x:Name="ConversationScroller" VerticalScrollBarVisibility="Auto" Padding="28,20,28,16">
            <ItemsControl ItemsSource="{Binding SelectedConversation.Messages}" ItemTemplate="{StaticResource MessageTemplate}"
                          HorizontalAlignment="Center" MaxWidth="748">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Grid>

      <!-- 底部输入区（有会话时） -->
      <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,14"
              Background="{StaticResource WindowBrush}"
              Visibility="{Binding HasMessages, Converter={StaticResource BoolToVisibility}}">
        <Grid MaxWidth="780">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="16"
                  Background="{StaticResource WindowBrush}">
            <Grid>
              <TextBox x:Name="PromptBox" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                       MinHeight="60" MaxHeight="200" AcceptsReturn="True" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                       Padding="16,13" FontSize="14.5" PreviewKeyDown="PromptBox_PreviewKeyDown" />
              <TextBlock Text="询问 DeepSeek Harness…" IsHitTestVisible="False" Margin="18,15,0,0"
                         Foreground="{StaticResource FaintTextBrush}" FontSize="14.5"
                         Visibility="{Binding InputText, Converter={StaticResource StringEmptyToVisibility}}" />
            </Grid>
          </Border>
          <Grid Grid.Row="1" Margin="4,8,2,0">
            <TextBlock Text="Ctrl + Enter 发送" Foreground="{StaticResource FaintTextBrush}" FontSize="11" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="停止" Style="{StaticResource DangerButtonStyle}" Click="Stop_Click"
                      IsEnabled="{Binding CanStop}" Visibility="{Binding CanStop, Converter={StaticResource BoolToVisibility}}"
                      Margin="0,0,8,0" MinWidth="72" />
              <Button Content="发送" Style="{StaticResource PrimaryButtonStyle}" Click="Send_Click"
                      IsEnabled="{Binding CanSend}" MinWidth="84" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
