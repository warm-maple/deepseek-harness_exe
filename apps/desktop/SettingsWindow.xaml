<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DeepSeekHarness.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="540" Height="470" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="30">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="Agent 设置" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,24" />

    <StackPanel Grid.Row="1" Margin="0,0,0,20">
      <TextBlock Text="DeepSeek API Key" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,7" />
      <PasswordBox x:Name="ApiKeyBox" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
                   BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Padding="11,9"
                   CaretBrush="{StaticResource TextBrush}" />
      <TextBlock Text="API Key 保存在 Windows 凭据管理器中，不会写入配置文件。" Foreground="{StaticResource FaintTextBrush}" FontSize="11" Margin="0,7,0,0" />
    </StackPanel>

    <StackPanel Grid.Row="2" Margin="0,0,0,20">
      <TextBlock Text="模型" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,7" />
      <ComboBox x:Name="ModelBox" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Padding="8" MinHeight="38">
        <ComboBoxItem Content="deepseek-v4-pro" />
        <ComboBoxItem Content="deepseek-v4-flash" />
      </ComboBox>
    </StackPanel>

    <StackPanel Grid.Row="3" Margin="0,0,0,20">
      <TextBlock Text="Agent 预设（模式）" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,7" />
      <ComboBox x:Name="PresetBox" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Padding="8" MinHeight="38">
        <ComboBoxItem Content="标准模式（功能完整）" Tag="standard" />
        <ComboBoxItem Content="代码模式（PTC，程序化工具）" Tag="code" />
        <ComboBoxItem Content="极简模式（双工具）" Tag="minimal" />
        <ComboBoxItem Content="创造模式（创建自定义预设）" Tag="cordis" />
      </ComboBox>
      <TextBlock Text="与源项目一致的四种 Agent 预设：标准 / 代码 / 极简 / 创造。" Foreground="{StaticResource FaintTextBrush}" FontSize="11" Margin="0,7,0,0" />
    </StackPanel>

    <StackPanel Grid.Row="4">
      <TextBlock Text="权限模式" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,7" />
      <ComboBox x:Name="PermissionBox" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Padding="8" MinHeight="38">
        <ComboBoxItem Content="工作区写入（workspace-write）" Tag="workspace-write" />
        <ComboBoxItem Content="只读（read-only）" Tag="read-only" />
        <ComboBoxItem Content="完全访问（danger-full-access）" Tag="danger-full-access" />
      </ComboBox>
      <TextBlock Text="工作区写入：Agent 可读写工作区内文件，危险操作需确认。" Foreground="{StaticResource FaintTextBrush}" FontSize="11" Margin="0,7,0,0" />
    </StackPanel>

    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="取消" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" />
      <Button Content="保存" Click="Save_Click" Style="{StaticResource PrimaryButtonStyle}" />
    </StackPanel>
  </Grid>
</Window>
