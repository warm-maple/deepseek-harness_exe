<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DeepSeekHarness.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="920" Height="620" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="210" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- 左侧导航（web 设置面板 nav rail） -->
    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <StackPanel Margin="14,20,14,0">
        <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,18" />
        <Button x:Name="NavGeneralBtn" Click="NavGeneral_Click" HorizontalContentAlignment="Left"
                Style="{StaticResource SecondaryButtonStyle}" Background="Transparent" BorderBrush="Transparent"
                Padding="12,10" Margin="0,0,0,4">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="⚙" FontSize="14" />
            <TextBlock Text="通用" FontSize="14" Margin="10,0,0,0" />
          </StackPanel>
        </Button>
        <Button x:Name="NavModelsBtn" Click="NavModels_Click" HorizontalContentAlignment="Left"
                Style="{StaticResource SecondaryButtonStyle}" Background="Transparent" BorderBrush="Transparent"
                Padding="12,10">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="📊" FontSize="14" />
            <TextBlock Text="模型" FontSize="14" Margin="10,0,0,0" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <!-- 右侧内容区 -->
    <Grid Grid.Column="1" Margin="34,26,34,22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ===== 通用 ===== -->
      <Grid x:Name="GeneralPanel">
        <StackPanel>
          <TextBlock Text="通用" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4" />
          <TextBlock Text="会话与 Agent 的默认配置" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,26" />

          <!-- 工作区 -->
          <TextBlock Text="工作区" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />
          <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="WorkspaceBox" Text="{Binding Workspace, Mode=OneWay}" IsReadOnly="True"
                     Background="{StaticResource PanelBrush}" Padding="12,9" />
            <Button Grid.Column="1" Content="浏览…" Click="BrowseWorkspace_Click" Margin="8,0,0,0"
                    Style="{StaticResource SecondaryButtonStyle}" Padding="14,8" />
          </Grid>

          <!-- 权限 -->
          <TextBlock Text="权限" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="选择新会话的默认权限模式" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <ComboBox Grid.Column="1" x:Name="PermissionBox" MinWidth="230" Margin="12,0,0,0"
                      Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
                      BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Padding="8" MinHeight="36">
              <ComboBoxItem Content="工作区写入（Workspace Write）" Tag="workspace-write" />
              <ComboBoxItem Content="只读（Read Only）" Tag="read-only" />
              <ComboBoxItem Content="完全访问（Full Access）" Tag="danger-full-access" />
            </ComboBox>
          </Grid>
          <TextBlock Text="工作区写入：Agent 可读写工作区内文件，危险操作需确认；Full Access 会减少确认步骤。" Foreground="{StaticResource FaintTextBrush}" FontSize="11" Margin="0,0,0,22" />

          <!-- 模型 -->
          <TextBlock Text="模型" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="驱动 Agent 的模型" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
            </StackPanel>
            <ComboBox Grid.Column="1" x:Name="ModelBox" MinWidth="230" Margin="12,0,0,0"
                      Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
                      BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Padding="8" MinHeight="36">
              <ComboBoxItem Content="deepseek-v4-pro" />
              <ComboBoxItem Content="deepseek-v4-flash" />
            </ComboBox>
          </Grid>
          <TextBlock Text="更多模型可在下方「模型」页配置 API Key 后使用。" Foreground="{StaticResource FaintTextBrush}" FontSize="11" Margin="0,0,0,22" />

          <!-- Agent 预设 -->
          <TextBlock Text="Agent 预设（模式）" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="与源项目一致的四种 Agent 预设" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
            </StackPanel>
            <ComboBox Grid.Column="1" x:Name="PresetBox" MinWidth="230" Margin="12,0,0,0"
                      Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
                      BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Padding="8" MinHeight="36">
              <ComboBoxItem Content="标准模式（功能完整）" Tag="standard" />
              <ComboBoxItem Content="代码模式（PTC，程序化工具）" Tag="code" />
              <ComboBoxItem Content="极简模式（双工具）" Tag="minimal" />
              <ComboBoxItem Content="创造模式（创建自定义预设）" Tag="cordis" />
            </ComboBox>
          </Grid>
          <TextBlock Text="标准：功能完整；代码：PTC 程序化调用工具；极简：仅持久 bash 与编辑器；创造：可读写自身运行环境。" Foreground="{StaticResource FaintTextBrush}" FontSize="11" />
        </StackPanel>
      </Grid>

      <!-- ===== 模型 ===== -->
      <Grid x:Name="ModelsPanel" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="模型" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4" />
          <TextBlock Text="API Key 与模型配置" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,26" />

          <TextBlock Text="DeepSeek API Key" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />
          <PasswordBox x:Name="ApiKeyBox" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
                       BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Padding="12,9"
                       CaretBrush="{StaticResource TextBrush}" />
          <TextBlock Text="API Key 保存在 Windows 凭据管理器中，不会写入配置文件。" Foreground="{StaticResource FaintTextBrush}" FontSize="11" Margin="0,8,0,0" />
        </StackPanel>
      </Grid>

      <!-- 底部按钮 -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button Content="取消" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" MinWidth="88" />
        <Button Content="保存" Click="Save_Click" Style="{StaticResource PrimaryButtonStyle}" MinWidth="88" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
